# BIS Search RAG Environment Configuration

# Google AI Studio API Key (for Gemini fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Local LLM (Ollama) Settings
OLLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2
GEMINI_MODEL=gemini-2.5-flash
LOCAL_TIMEOUT=12.0
 
# Bureau of Indian Standards (BIS) Portal Login Credentials
# Used for downloading official full Indian Standard PDFs from standardsbis.bsbedge.com
BIS_USERNAME=
BIS_PASSWORD=
